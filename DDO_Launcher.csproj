<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DDO_Launcher</AssemblyName>
    <Version>1.2.0.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Company>White Dragon Temple</Company>
    <Product>DDO_Launcher</Product>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Remove="Arrowgene.DragonsDogmaOnline\**" />
    <EmbeddedResource Remove="Arrowgene.DragonsDogmaOnline\**" />
    <None Remove="Arrowgene.DragonsDogmaOnline\**" />
    <Page Remove="Arrowgene.DragonsDogmaOnline\**" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Arrowgene.Buffers" Version="1.0.2" />
    <PackageReference Include="Arrowgene.Logging" Version="1.2.1" />
    <PackageReference Include="ini-parser" Version="2.5.2" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
    <Content Include="DDO_Launcher.ini" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Arrowgene.DragonsDogmaOnline\Arrowgene.Ddon.Client\Arrowgene.Ddon.Client.csproj" />
    <ProjectReference Include="Arrowgene.DragonsDogmaOnline\Arrowgene.Ddon.Shared\Arrowgene.Ddon.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\EBGaramond-Regular.ttf" />
    <Resource Include="Fonts\Geo-Regular.ttf" />
    <Resource Include="icon.ico" />
    <Resource Include="Images\launcher\logo.png" />
    <Resource Include="Images\launcher\background.png" />
    <Resource Include="Images\news\newsbanner.png" />
    <Resource Include="Images\news\localnewsbanner.png" Condition="Exists('Images\news\localnewsbanner.png')" />
    <Resource Include="Update\update_launcher.bat">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="RemoveSymbolsFromPublishItems"
          BeforeTargets="_CopyResolvedFilesToPublishPreserveNewest;_CopyResolvedFilesToPublishAlways">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('Files\'))" />
      <_ResolvedFileToPublishPreserveNewest Remove="@(_ResolvedFileToPublishPreserveNewest)" Condition="'%(Extension)' == '.pdb'" />
      <_ResolvedFileToPublishPreserveNewest Remove="@(_ResolvedFileToPublishPreserveNewest)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('Files\'))" />
      <_ResolvedFileToPublishAlways Remove="@(_ResolvedFileToPublishAlways)" Condition="'%(Extension)' == '.pdb'" />
      <_ResolvedFileToPublishAlways Remove="@(_ResolvedFileToPublishAlways)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('Files\'))" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveObsoleteLauncherConfigFromPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Delete Files="$(PublishDir)$(AssemblyName).dll.config;$(PublishDir)$(AssemblyName).exe.config" TreatErrorsAsWarnings="true" />
  </Target>
</Project>
